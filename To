-- ฟังก์ชั่นช่วยสร้างปุ่มกด (Toggle Button Maker)
local function CreateToggleButton(text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = Container
    btn.Size = UDim2.new(1, -10, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(12, 22, 12)
    btn.BorderColor3 = Color3.fromRGB(0, 150, 60)
    btn.BorderSizePixel = 1
    btn.Text = text .. " : [ ปิด ]"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansBold

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(0, 60, 20)
            btn.BorderColor3 = Color3.fromRGB(0, 255, 100)
            btn.TextColor3 = Color3.fromRGB(0, 255, 100)
            btn.Text = text .. " : [ เปิด ]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(12, 22, 12)
            btn.BorderColor3 = Color3.fromRGB(0, 150, 60)
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.Text = text .. " : [ ปิด ]"
        end
        callback(state)
    end)
    return btn
end

